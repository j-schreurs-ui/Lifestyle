const STORAGE_KEY = 'comeback_v1';
 
let state = {
  workouts: {},
  foodLog: {},
  weights: [],
  settings: { target: 2400, goalWeight: 85 },
  favorites: [],
  recents: []
};
 
function todayKey() { return new Date().toISOString().slice(0, 10); }
function fmtDate(d) {
  const date = new Date(d);
  const dn = ['zo','ma','di','wo','do','vr','za'];
  const mn = ['jan','feb','mrt','apr','mei','jun','jul','aug','sep','okt','nov','dec'];
  return `${dn[date.getDay()]} ${date.getDate()} ${mn[date.getMonth()]}`;
}
function genId() { return Math.random().toString(36).slice(2, 9); }
function escapeHtml(s) {
  return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}
 
function loadState() {
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (raw) {
      const saved = JSON.parse(raw);
      state = { ...state, ...saved, settings: { ...state.settings, ...(saved.settings || {}) } };
    }
  } catch (e) { console.error('load failed', e); }
}
function saveState() {
  try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); }
  catch (e) { console.error('save failed', e); }
}
 
function searchFoods(q) {
  if (!q || q.length < 1) return [];
  const ql = q.toLowerCase();
  const prefix = [], wordPrefix = [], sub = [];
  for (const f of foods) {
    const nl = f.name.toLowerCase();
    if (nl.startsWith(ql)) prefix.push(f);
    else if (nl.split(/[\s(/]/).some(w => w.startsWith(ql))) wordPrefix.push(f);
    else if (nl.includes(ql)) sub.push(f);
  }
  return [...prefix, ...wordPrefix, ...sub].slice(0, 8);
}
 
function logFood(name, cal, meal, addToRecent = true) {
  const k = todayKey();
  if (!state.foodLog[k]) state.foodLog[k] = [];
  state.foodLog[k].push({ name, cal, meal });
  if (addToRecent) {
    state.recents = state.recents.filter(r => !(r.name === name && r.cal === cal));
    state.recents.unshift({ name, cal });
    state.recents = state.recents.slice(0, 8);
  }
  saveState();
  renderToday();
  renderProgress();
}
 
function getCurrentMeal() { return document.getElementById('meal-select').value; }
function todayCalories() {
  const log = state.foodLog[todayKey()] || [];
  return log.reduce((s, i) => s + i.cal, 0);
}
function dayBurn() { return state.foodLog[todayKey() + '_burn'] || 0; }
 
function renderRing() {
  const eaten = todayCalories();
  const target = state.settings.target;
  const burn = dayBurn();
  const adjusted = target + burn;
  const remaining = adjusted - eaten;
 
  document.getElementById('cal-eaten').textContent = Math.round(eaten);
  document.getElementById('cal-target').textContent = Math.round(adjusted);
  document.getElementById('cal-remaining').textContent = Math.round(Math.abs(remaining)) + (remaining < 0 ? ' kcal over je doel' : ' kcal te gaan');
 
  const bonus = document.getElementById('cal-bonus');
  if (burn > 0) { bonus.style.display = 'block'; bonus.textContent = `+${burn} kcal verbrand vandaag`; }
  else { bonus.style.display = 'none'; }
 
  const ring = document.getElementById('ring-fg');
  const pct = adjusted > 0 ? Math.min(eaten / adjusted, 1) : 0;
  const circ = 213.6;
  ring.setAttribute('stroke-dashoffset', circ - (circ * pct));
  ring.setAttribute('stroke', remaining < 0 ? '#A32D2D' : '#0F6E56');
}
 
function renderSearchResults() {
  const q = document.getElementById('search').value;
  const results = searchFoods(q);
  const container = document.getElementById('search-results');
  if (!q) { container.classList.add('empty'); container.innerHTML = ''; return; }
  container.classList.remove('empty');
  if (results.length === 0) {
    container.innerHTML = '<div class="search-empty">Geen match — probeer "+ Eigen item"</div>';
    return;
  }
  container.innerHTML = results.map(f =>
    `<div class="search-result" data-name="${escapeHtml(f.name)}" data-cal="${f.cal}">
      <span>${escapeHtml(f.name)}</span>
      <span class="search-result-cal">${f.cal} kcal</span>
    </div>`
  ).join('');
  container.querySelectorAll('.search-result').forEach(el => {
    el.addEventListener('click', () => {
      logFood(el.dataset.name, parseInt(el.dataset.cal), getCurrentMeal());
      document.getElementById('search').value = '';
      renderSearchResults();
    });
  });
}
 
function renderRecents() {
  const panel = document.getElementById('recents-panel');
  const container = document.getElementById('recents');
  if (state.recents.length === 0) { panel.style.display = 'none'; return; }
  panel.style.display = 'block';
  container.innerHTML = state.recents.map(r =>
    `<button class="chip" data-name="${escapeHtml(r.name)}" data-cal="${r.cal}">${escapeHtml(r.name)}<span class="chip-cal">${r.cal}</span></button>`
  ).join('');
  container.querySelectorAll('.chip').forEach(el => {
    el.addEventListener('click', () => {
      logFood(el.dataset.name, parseInt(el.dataset.cal), getCurrentMeal());
    });
  });
}
 
function renderFavorites() {
  const container = document.getElementById('favorites');
  if (state.favorites.length === 0) {
    container.innerHTML = '<div class="fav-empty">Nog geen favorieten — sla onderaan een maaltijd op om hier sneller te loggen.</div>';
    return;
  }
  container.innerHTML = `<div class="fav-grid">${state.favorites.map(f => {
    const total = f.items.reduce((s, i) => s + i.cal, 0);
    return `<div class="fav-card" data-id="${f.id}">
      <button class="fav-x" data-del="${f.id}">×</button>
      <div class="fav-name">${escapeHtml(f.name)}</div>
      <div class="fav-meta">${f.items.length} items · ${total} kcal</div>
    </div>`;
  }).join('')}</div>`;
  container.querySelectorAll('.fav-card').forEach(el => {
    el.addEventListener('click', (e) => {
      if (e.target.classList.contains('fav-x')) return;
      const fav = state.favorites.find(f => f.id === el.dataset.id);
      if (!fav) return;
      const meal = getCurrentMeal();
      const k = todayKey();
      if (!state.foodLog[k]) state.foodLog[k] = [];
      fav.items.forEach(i => state.foodLog[k].push({ name: i.name, cal: i.cal, meal }));
      saveState();
      renderToday();
      renderProgress();
    });
  });
  container.querySelectorAll('.fav-x').forEach(el => {
    el.addEventListener('click', (e) => {
      e.stopPropagation();
      const id = el.dataset.del;
      const fav = state.favorites.find(f => f.id === id);
      if (!fav || !confirm(`Favoriet "${fav.name}" verwijderen?`)) return;
      state.favorites = state.favorites.filter(f => f.id !== id);
      saveState();
      renderFavorites();
    });
  });
}
 
function renderMeals() {
  const meals = ['ontbijt', 'lunch', 'diner', 'snack'];
  const log = state.foodLog[todayKey()] || [];
  meals.forEach(m => {
    const list = document.querySelector(`#meal-${m} .meal-list`);
    const saveBtn = document.querySelector(`#meal-${m} .save-fav-btn`);
    list.innerHTML = '';
    const items = log.filter(i => i.meal === m);
    if (items.length === 0) {
      list.innerHTML = '<div class="empty">Nog niets toegevoegd</div>';
      saveBtn.classList.add('hidden');
    } else {
      saveBtn.classList.remove('hidden');
      items.forEach(item => {
        const realIdx = log.indexOf(item);
        const div = document.createElement('div');
        div.className = 'food-item';
        div.innerHTML = `<span>${escapeHtml(item.name)}</span><span style="display:flex;align-items:center;"><span class="food-cal">${item.cal} kcal</span><button class="food-x" data-idx="${realIdx}">×</button></span>`;
        list.appendChild(div);
      });
    }
  });
  document.querySelectorAll('.food-x').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const idx = parseInt(e.target.dataset.idx);
      const k = todayKey();
      state.foodLog[k].splice(idx, 1);
      saveState();
      renderToday();
      renderProgress();
    });
  });
  document.querySelectorAll('.save-fav-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const meal = btn.dataset.meal;
      const items = (state.foodLog[todayKey()] || []).filter(i => i.meal === meal).map(i => ({ name: i.name, cal: i.cal }));
      if (items.length === 0) return;
      const name = prompt('Naam voor deze favoriet:', `Mijn ${meal}`);
      if (!name) return;
      state.favorites.push({ id: genId(), name, items });
      saveState();
      renderFavorites();
    });
  });
}
 
function renderTodaySessions() {
  const container = document.getElementById('today-sess-list');
  let curWeek = 1, found = false;
  for (let w = 0; w < schedule.length; w++) {
    const done = schedule[w].sessions.filter((_, sIdx) => state.workouts[`w${w+1}s${sIdx}`]).length;
    if (!found && done < schedule[w].sessions.length) { curWeek = w + 1; found = true; break; }
    if (w === schedule.length - 1) curWeek = schedule.length + 1;
  }
  if (curWeek > schedule.length) {
    container.innerHTML = '<div class="empty">Alle 8 weken voltooid 🎉</div>';
    return;
  }
  const wk = schedule[curWeek - 1];
  let html = `<div style="font-size: 12px; color: var(--text-2); margin-bottom: 6px; padding: 0 4px;">Week ${curWeek} — ${wk.focus}</div>`;
  wk.sessions.forEach((s, sIdx) => {
    const id = `w${curWeek}s${sIdx}`;
    const done = !!state.workouts[id];
    html += `<div class="ses">
      <span class="pill ${s.type === 'run' ? 'pill-run' : 'pill-walk'}">${s.type === 'run' ? 'Lopen' : 'Wandel'}</span>
      <span class="ses-txt${done ? ' done' : ''}">${escapeHtml(s.text)}</span>
      <span class="ses-burn">~${s.burn} kcal</span>
      <input type="checkbox" data-sess="${id}" data-burn="${s.burn}" ${done ? 'checked' : ''}>
    </div>`;
  });
  container.innerHTML = html;
  container.querySelectorAll('input[type="checkbox"]').forEach(cb => {
    cb.addEventListener('change', (e) => {
      toggleWorkout(e.target.dataset.sess, parseInt(e.target.dataset.burn), e.target.checked);
    });
  });
}
 
function toggleWorkout(id, burn, checked) {
  const tKey = todayKey();
  if (checked) {
    state.workouts[id] = true;
    state.foodLog[tKey + '_burn'] = (state.foodLog[tKey + '_burn'] || 0) + burn;
  } else {
    delete state.workouts[id];
    state.foodLog[tKey + '_burn'] = Math.max(0, (state.foodLog[tKey + '_burn'] || 0) - burn);
  }
  saveState();
  renderToday();
  renderSchedule();
  renderProgress();
}
 
function renderToday() {
  renderRing();
  renderRecents();
  renderFavorites();
  renderMeals();
  renderTodaySessions();
}
 
function renderSchedule() {
  const container = document.getElementById('weeks');
  let curWeek = 1, found = false;
  schedule.forEach((wk, wIdx) => {
    const done = wk.sessions.filter((_, sIdx) => state.workouts[`w${wIdx+1}s${sIdx}`]).length;
    if (!found && done < wk.sessions.length) { curWeek = wIdx + 1; found = true; }
  });
  container.innerHTML = '';
  schedule.forEach((wk, wIdx) => {
    const weekNum = wIdx + 1;
    const isCurrent = weekNum === curWeek;
    const doneInWeek = wk.sessions.filter((_, sIdx) => state.workouts[`w${weekNum}s${sIdx}`]).length;
    const div = document.createElement('div');
    div.className = 'week' + (isCurrent ? ' current' : '');
    let html = `<div class="week-head"><div class="week-l"><span class="week-num">Week ${weekNum}</span><span class="week-focus">${escapeHtml(wk.focus)}</span>${isCurrent ? '<span class="week-badge">Nu</span>' : ''}</div><span class="week-prog">${doneInWeek}/${wk.sessions.length}</span></div>`;
    wk.sessions.forEach((s, sIdx) => {
      const id = `w${weekNum}s${sIdx}`;
      const done = !!state.workouts[id];
      html += `<div class="ses"><span class="pill ${s.type === 'run' ? 'pill-run' : 'pill-walk'}">${s.type === 'run' ? 'Lopen' : 'Wandel'}</span><span class="ses-txt${done ? ' done' : ''}">${escapeHtml(s.text)}</span><input type="checkbox" data-id="${id}" data-burn="${s.burn}" ${done ? 'checked' : ''}></div>`;
    });
    div.innerHTML = html;
    container.appendChild(div);
  });
  container.querySelectorAll('input[type="checkbox"]').forEach(cb => {
    cb.addEventListener('change', (e) => {
      toggleWorkout(e.target.dataset.id, parseInt(e.target.dataset.burn), e.target.checked);
    });
  });
}
 
function renderProgress() {
  const totalSessions = Object.keys(state.workouts).length;
  document.getElementById('p-sess').textContent = totalSessions;
 
  if (state.weights.length > 0) {
    const latest = state.weights[state.weights.length - 1];
    document.getElementById('p-weight').innerHTML = `${latest.weight}<small> kg</small>`;
    if (state.settings.goalWeight) {
      const togo = (latest.weight - state.settings.goalWeight).toFixed(1);
      const sign = togo > 0 ? '−' : '+';
      document.getElementById('p-diff').innerHTML = `${sign}${Math.abs(togo)}<small> kg</small>`;
    } else {
      document.getElementById('p-diff').innerHTML = '<small>geen doel</small>';
    }
  } else {
    document.getElementById('p-weight').innerHTML = '<small>—</small>';
    document.getElementById('p-diff').innerHTML = '<small>—</small>';
  }
 
  const chart = document.getElementById('cal-chart');
  chart.innerHTML = '';
  const today = new Date();
  const target = state.settings.target;
  let maxCal = target * 1.3;
  const days = [];
  for (let i = 6; i >= 0; i--) {
    const d = new Date(today);
    d.setDate(d.getDate() - i);
    const key = d.toISOString().slice(0, 10);
    const log = state.foodLog[key] || [];
    const cal = log.reduce((s, item) => s + item.cal, 0);
    if (cal > maxCal) maxCal = cal;
    days.push({ key, cal, label: ['Zo','Ma','Di','Wo','Do','Vr','Za'][d.getDay()] });
  }
  days.forEach(d => {
    const col = document.createElement('div');
    col.className = 'bar-col';
    const h = d.cal > 0 ? Math.max(2, (d.cal / maxCal) * 84) : 2;
    const over = d.cal > target;
    col.innerHTML = `<div class="bar${over ? ' over' : ''}" style="height: ${h}px;">${d.cal > 0 ? `<span class="bar-v">${Math.round(d.cal)}</span>` : ''}</div><div class="bar-l">${d.label}</div>`;
    chart.appendChild(col);
  });
 
  const hist = document.getElementById('weight-history');
  if (state.weights.length === 0) {
    hist.textContent = 'Nog geen metingen toegevoegd.';
  } else {
    const recent = state.weights.slice(-5).reverse();
    hist.innerHTML = recent.map(w => `<div style="display: flex; justify-content: space-between; padding: 3px 0;"><span>${fmtDate(w.date)}</span><span>${w.weight} kg</span></div>`).join('');
  }
 
  document.getElementById('target-input').value = state.settings.target;
  if (state.settings.goalWeight) document.getElementById('goal-weight-input').value = state.settings.goalWeight;
}
 
function setupTabs() {
  document.querySelectorAll('.tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.view').forEach(v => v.classList.add('hidden'));
      tab.classList.add('active');
      document.getElementById('view-' + tab.dataset.tab).classList.remove('hidden');
      window.scrollTo(0, 0);
    });
  });
}
 
function setupHandlers() {
  document.getElementById('search').addEventListener('input', renderSearchResults);
 
  document.getElementById('custom-toggle').addEventListener('click', () => {
    document.getElementById('custom-form').classList.toggle('hidden');
  });
 
  document.getElementById('add-custom').addEventListener('click', () => {
    const name = document.getElementById('custom-name').value.trim();
    const cal = parseInt(document.getElementById('custom-cal').value);
    if (!name || isNaN(cal)) return;
    logFood(name, cal, getCurrentMeal());
    document.getElementById('custom-name').value = '';
    document.getElementById('custom-cal').value = '';
  });
 
  document.getElementById('weight-save').addEventListener('click', () => {
    const w = parseFloat(document.getElementById('weight-input').value);
    if (isNaN(w) || w <= 0) return;
    state.weights.push({ date: new Date().toISOString(), weight: w });
    saveState();
    document.getElementById('weight-input').value = '';
    renderProgress();
  });
 
  document.getElementById('target-input').addEventListener('change', (e) => {
    const v = parseInt(e.target.value);
    if (v >= 1200 && v <= 4000) {
      state.settings.target = v;
      saveState();
      renderToday();
    }
  });
 
  document.getElementById('goal-weight-input').addEventListener('change', (e) => {
    const v = parseFloat(e.target.value);
    state.settings.goalWeight = isNaN(v) ? null : v;
    saveState();
    renderProgress();
  });
 
  document.getElementById('reset').addEventListener('click', () => {
    if (!confirm('Alle data wissen? Dit kan niet ongedaan gemaakt worden.')) return;
    state = { workouts: {}, foodLog: {}, weights: [], settings: { target: 2400, goalWeight: 85 }, favorites: [], recents: [] };
    saveState();
    renderToday();
    renderSchedule();
    renderProgress();
  });
}
 
document.getElementById('today-date').textContent = fmtDate(new Date());
loadState();
setupTabs();
setupHandlers();
renderToday();
renderSchedule();
renderProgress();
</script>
